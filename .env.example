# Copia este archivo como .env y ajusta lo que necesites.

# --- Modelos (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Modelo del agente: debe tener "tools" en `ollama show <modelo>`. Más grande = decisiones más fiables.
OLLAMA_MODEL_AGENTE=qwen3:4b
OLLAMA_EMBEDDINGS=bge-m3

# --- Qdrant ---
# Vacío: modo local (carpeta qdrant_data/). En Docker, el compose lo define como http://qdrant:6333.
QDRANT_URL=
QDRANT_VERSION=v1.18.0

# --- Reglas de negocio y simulación ---
UMBRAL_APROBACION_COP=300000
TRANSPORTADORAS_NO_DISPONIBLES=Envía
FECHA_REFERENCIA=2026-09-24

# --- Seguridad ---
# Interruptor de emergencia: true = el agente no puede generar etiquetas (solo lectura)
MODO_SOLO_LECTURA=false
MAX_PASOS_AGENTE=25

# --- Interfaz ---
PUERTO=7860

# --- Observabilidad (LangSmith, opcional) ---
# Traza cada turno: router -> rag/agente -> llamadas a herramientas -> llamadas al LLM,
# con sus entradas/salidas y duración. Crea una clave gratis en https://smith.langchain.com
# (Settings > API Keys) y descomenta estas líneas. No se requiere cambiar código: langsmith
# ya viene instalado como dependencia de langchain-core y se activa solo con estas variables.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=ecomarket-agente
