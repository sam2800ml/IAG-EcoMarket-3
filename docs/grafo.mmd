---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	router(router)
	rag(rag)
	directo(directo)
	escalamiento(escalamiento)
	agente(agente)
	confirmar(confirmar)
	herramientas(herramientas)
	__end__([<p>__end__</p>]):::last
	__start__ --> router;
	agente -.-> __end__;
	agente -.-> confirmar;
	agente -.-> herramientas;
	confirmar -.-> agente;
	confirmar -.-> herramientas;
	herramientas --> agente;
	router -.-> agente;
	router -.-> directo;
	router -.-> escalamiento;
	router -.-> rag;
	directo --> __end__;
	escalamiento --> __end__;
	rag --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
